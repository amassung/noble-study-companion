# Supabase (public — safe in the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server-only — NEVER use VITE_ prefix, never expose
# to the browser). Required for in-app account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (server-only — never use VITE_ prefix)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional override (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5
